{
  "name": "agora-blanc-mesnil",
  "version": "1.0.0",
  "scripts": {
    "ng": "ng",
    "prebuild": "node scripts/build-propositions.js",
    "postbuild": "node -e \"const fs=require('fs'),b='dist/Programme/browser';fs.copyFileSync(b+'/index.html',b+'/404.html');fs.writeFileSync(b+'/.nojekyll','')\"",
    "prestart": "node scripts/build-propositions.js",
    "start": "ng serve",
    "build": "ng build",
    "deploy": "npm run build && npx gh-pages -d dist/Programme/browser --dotfiles",
    "build:propositions": "node scripts/build-propositions.js",
    "watch": "ng build --watch --configuration development",
    "test": "ng test"
  },
  "private": true,
  "packageManager": "npm@11.4.1",
  "dependencies": {
    "@angular/common": "^21.2.0",
    "@angular/compiler": "^21.2.0",
    "@angular/core": "^21.2.0",
    "@angular/forms": "^21.2.0",
    "@angular/platform-browser": "^21.2.0",
    "@angular/router": "^21.2.0",
    "marked": "^5.1.1",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^21.2.3",
    "@angular/cli": "^21.2.3",
    "@angular/compiler-cli": "^21.2.0",
    "gh-pages": "^6.3.0",
    "prettier": "^3.8.1",
    "typescript": "~5.9.2"
  }
}
